# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Supabase configuration (Auth, Postgres, RLS & RPCs)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional Google OAuth credentials for standalone Express auth mode
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional signing secret for standalone Express session tokens
SESSION_SECRET=""

# GEMINI_API_KEY: Server-side only key for Phase 3 "Speak Your Day" transcript drafting.
# Injected automatically from AI Studio Secrets at runtime. Never prefix with VITE_.
GEMINI_API_KEY=""

# Optional per-user rate limit for /api/voice/parse per 10-minute window (default: 12)
VOICE_RATE_LIMIT_MAX="12"

# Optional override for local SQLite data directory (default: ./data)
TALLYMARK_DATA_DIR=""

# Optional flag to permit direct email dev sign-in when NODE_ENV=production (default: false)
ALLOW_DEV_AUTH="false"

# V2 Slice 2: Kill switches (set to "true" to return 503 immediately)
DISABLE_PUBLIC_CLAIMS="false"
DISABLE_PUBLIC_QUOTE_ACTIONS="false"

# V2 Slice 2: Opt-in Web Push VAPID keys (keep VAPID_PRIVATE_KEY server-only)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@tallymark.app"

# V2 Slice 2: Public bot check signing secret & optional Cloudflare Turnstile
BOT_CHECK_SECRET=""
TURNSTILE_SECRET_KEY=""
VITE_TURNSTILE_SITE_KEY=""

# V2 Slice 2: Secret for triggering the 90-day proof retention cron endpoint
RETENTION_CRON_SECRET=""
